</ul>\n        </div>\n\n        <!-- 1013\u5e74 -->\n        <div class=\"year-section\">\n            <h3 class=\"year-title\">\u516c\u51431013\u5e74</h3>\n            <ul class=\"event-list\">\n                <li class=\"event-item\">\n                    <span class=\"event-region\">\u6b27\u6d32 \u00b7 \u82f1\u683c\u5170</span>\n                    <div class=\"event-title\">\u514b\u52aa\u7279\u5927\u5e1d\u5de9\u56fa\u5bf9\u82f1\u683c\u5170\u7684\u63a7\u5236</div>\n                    <div class=\"event-desc\">\u514b\u52aa\u7279\u7ee7\u7eed\u7edf\u6cbb\u82f1\u683c\u5170\uff0c\u5176\u5317\u6d77\u5e1d\u56fd\u8fbe\u5230\u9f0e\u76db\u65f6\u671f\u3002\u4ed6\u8bd5\u56fe\u5c06\u4e39\u9ea6\u3001\u632a\u5a01\u548c\u82f1\u683c\u5170\u7edf\u4e00\u5728\u4e00\u4e2a\u738b\u6743\u4e4b\u4e0b\u3002</div>\n                </li>\n            </ul>\n        </div>\n\n        <!-- 1014\u5e74 -->\n       =\"year-section\">\n            <h3 class=\"year-title\">\u516c\u51431014\u5e74</h3>\n            <ul class=\"event-list\">\n                <li class=\"event-item\">\n                    <span class=\"event-region\">\u6b27\u6d32 \u00b7 \u5308\u7259\u5229/\u5fb7\u610f\u5fd7</span>\n                    <div class=\"event-title\">\u7d22\u5c14\u83ab\u65af\u6218\u5f79\uff08Szl\u00e1geri csata\uff09</div>\n                    <div class=\"event-desc\">\u795e\u5723\u7f57\u9a6c\u5e1d\u56fd\u7687\u5e1d\u4ea8\u5229\u4e8c\u4e16\u5728\u7d22\u5c14\u83ab\u65af\u6218\u5f79\u4e2d\u51fb\u8d25\u9a6c\u624e\u5c14\u4eba\uff08\u5308\u7259\u5229\u4eba\uff09\uff0c\u8fdb\u4e00\u6b65\u5de9\u56fa\u4e86\u5fb7\u610f\u5fd7\u4e1c\u90e8\u8fb9\u7586\u7684\u5b89\u5168\u3002\u6b64\u6218\u6807\u5fd7\u7740\u9a6c\u624e\u5c14\u4eba\u5bf9\u4e2d\u6b27\u5165\u4fb5\u7684\u7ec8\u7ed3\u3002</div>\n                </li>\n            </ul>\n        </div>\n\n        <!-- 1015\u5e74 -->\n        <div class=\"year-section\">\n            <h3 class=\"year-title\">\u516c\u51431015\u5e74</h3>\n            <ul class=\"event-list\">\n