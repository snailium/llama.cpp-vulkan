"event-list\">\n                <li class=\"event-item\">\n                    <span class=\"event-region\">\u6b27\u6d32 \u00b7 \u82f1\u683c\u5170/\u4e39\u9ea6</span>\n                    <div class=\"event-title\">\u514b\u52aa\u7279\u5927\u5e1d\u7ee7\u7eed\u7edf\u6cbb\u82f1\u683c\u5170\u548c\u4e39\u9ea6</div>\n                    <div class=\"event-desc\">\u514b\u52aa\u7279\u5de9\u56fa\u5176\u5728\u82f1\u683c\u5170\u3001\u4e39\u9ea6\u548c\u632a\u5a01\u7684\u7edf\u6cbb\uff0c\u6210\u4e3a\u5317\u6b27\u5386\u53f2\u4e0a\u6700\u5177\u5f71\u54cd\u529b\u7684\u541b\u4e3b\u4e4b\u4e00\u3002\u4ed6\u63a8\u884c\u57fa\u7763\u6559\u5316\u653f\u7b56\uff0c\u52a0\u5f3a\u4e2d\u592e\u7ba1\u7406\u3002</div>\n                </li>\n                <li class=\"event-item\">\n                    <span class=\"event-region\">\u6b27\u6d32 \u00b7 \u5fb7\u610f\u5fd7</span>\n                    <div class=\"event-title\">\u795e\u5723\u7f57\u9a6c\u5e1d\u56fd\u7687\u5e1d\u4ea8\u5229\u4e8c\u4e16\u7ee7\u4f4d\uff08\u5b9e\u9645\u4e3a1002\u5e74\uff09</div>\n                    <div class=\"event-desc\">\u6ce8\uff1a\u5965\u6258\u4e09\u4e16\u4e8e1002\u5e74\u53bb\u4e16\uff0c\u5176\u5802\u5f1f\u4ea8\u5229\u4e8c\u4e16\uff08\u5eb7\u62c9\u5fb7\u4e8c\u4e16\u4e4b\u524d\u7684\u7687\u5e1d\uff09\u4e8e1002\u5e74\u5f53\u9009\u4e3a\u5fb7\u610f\u5fd7\u56fd\u738b\u548c\u795e\u5723\u7f57\u9a6c\u5e1d\u56fd\u7687\u5e1d\u3002\u81f31005\u5e74\uff0c\u4ea8\u5229\u4e8c\u4e16\u5728\u4f4d\u671f\u95f4\u81f4\u529b\u4e8e\u6559\u4f1a\u6539\u9769\u548c\u8fb9\u7586\u9632\u5fa1\u3002</div>\n                </li>\n            </ul>\n        </div>\n\n        <!-- 1006\u5e74 -->\n        <div class=\"year-section\">\n            <h3 class=\"year-title\">\u516c\u51431006\u5e74</h3>\n            <ul class=\"event-list\">\n                <li class=\"event-item\">\n                    <span class=\"event-region\">\u4f0a\u65af\u5170\u4e16\u754c \u00b7 \u57c3\u53ca</span>\n                    <div class=\"event-title\">\u6cd5\u8482\u739b\u54