# Keep build context small for faster + safer builds
.git
.gitignore
benchmark/
*.log
*.md
!README.md
!docs/VULKAN-TUNING.md
!CONTRIBUTING.md
!STATUS.md
node_modules/
.vscode/
.idea/
*.swp
.DS_Store

# Build artifacts
build/
*.so
*.so.*
llama
llama-*

# Docker
*.tar

# Models (never commit)
models/
*.gguf
*.bin

# Vendored glslc binary (Vulkan SDK) - staged into the image by the Dockerfile
# (COPY .devops/bin/glslc). Keep an explicit un-ignore so a future glob change
# (e.g. a broad *-like rule) cannot silently drop the 10 MB tool from the context.
!.devops/bin/glslc
