{
  "text": "```html\n<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>\u516c\u5143996\u5e74\u81f31024\u5e74\u4e16\u754c\u5927\u4e8b\u4ef6</title>\n    <style>\n        * {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        body {\n            font-family: \"Microsoft YaHei\", \"PingFang SC\", sans-serif;\n            background-color: #f5f5dc;\n            color: #333;\n            line-height: 1.8;\n            padding: 20px;\n        }\n\n        .container {\n            max-width: 900px;\n            margin: 0 auto;\n            background-color: #fff;\n            border-radius: 10px;\n            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);\n            padding: 40px;\n        }\n\n        h1 {\n            text-align: center;\n            color: #8b0000;\n            font-size: 2em;\n            margin-bottom: 30px;\n            border-bottom: 3px solid #8b0000;\n            padding-bottom: 15px;\n        }\n\n        .intro {\n            text-align: center;\n            color: #666;\n            margin-bottom: 40px;\n            font-size: 1.1em;\n        }\n\n        .timeline {\n            position: relative;\n            padding-left: 30px;\n        }\n\n        .year-section {\n            margin-bottom: 25px;\n            padding: 15px;\n            border-left: 4px solid #c9a96e;\n            background-color: #fdfaf3;\n            border-radius: 0 8px 8px 0;\n        }\n\n        .year-section:hover {\n            background-color: #f9f2e4;\n            transition: background-color 0.3s ease;\n        }\n\n        .year-title {\n            font-size: 1.5em;\n            color: #8b0000;\n            font-weight: bold;\n            margin-bottom: 10px;\n        }\n\n        .event-list {\n            list-style: none;\n            padding-left: 10px;\n        }\n\n        .event-list li {\n            padding: 8px 0;\n            border-bottom: 1px dashed #ddd;\n            font-size: 1em;\n        }\n\n        .event-list li:last-child {\n            border-bottom: none;\n        }\n\n        .event-list li::before {\n            content: \"\u25c6\";\n            color: #c9a96e;\n            margin-right: 8px;\n            font-size: 0.8em;\n        }\n\n        .region-tag {\n            display: inline-block;\n            background-color: #e8d5b7;\n            color: #5a3e1b;\n            padding: 2px 8px;\n            border-radius: 4px;\n            font-size: 0.85em;\n            margin-left: 8px;\n        }\n\n        footer {\n            text-align: center;\n            margin-top: 40px;\n            padding-top: 20px;\n            border-top: 1px solid #ddd;\n            color: #999;\n            font-size: 0.9em;\n        }\n\n        @media (max-width: 600px) {\n            .container {\n                padding: 20px;\n            }\n\n            h1 {\n                font-size: 1.5em;\n            }\n\n            .year-title {\n                font-size: 1.3em;\n            }\n        }\n    </style>\n</head>\n<body>\n    <div class=\"container\">\n        <h1>\u516c\u5143996\u5e74\u81f31024\u5e74\u4e16\u754c\u5927\u4e8b\u4ef6</h1>\n        <p class=\"intro\">\u4ee5\u4e0b\u662f\u516c\u5143996\u5e74\u81f31024\u5e74\u95f4\u4e16\u754c\u4e0a\u53d1\u751f\u7684\u91cd\u5927\u5386\u53f2\u4e8b\u4ef6\uff0c\u6db5\u76d6\u6b27\u6d32\u3001\u4e9a\u6d32\u3001\u4e2d\u4e1c\u7b49\u5730\u533a\u7684\u91cd\u8981\u53d1\u5c55\u3002</p>\n\n        <div class=\"timeline\">\n\n            <!-- 996\u5e74 -->\n            <div class=\"year-section\">\n                <div class=\"year-title\">996\u5e74</div>\n                <ul class=\"event-list\">\n                    <li>\u5b8b\u771f\u5b97\u5373\u4f4d\uff08\u8d75\u6052\uff09\uff0c\u5b8b\u671d\u8fdb\u5165\"\u54b8\u5e73\u4e4b\u6cbb\"\u65f6\u671f\u3002<span class=\"region-tag\">\u4e2d\u56fd</span></li>\n                    <li>\u5965\u65af\u66fc\u00b7\u8d1d\u683c\u5728\u62dc\u5360\u5ead\u5e1d\u56fd\u5b89\u7eb3\u6258\u5229\u4e9a\u5730\u533a\u5efa\u7acb\u65e9\u671f\u5965\u65af\u66fc\u90e8\u843d\u653f\u6743\u3002<span class=\"region-tag\">\u5c0f\u4e9a\u7ec6\u4e9a</span></li>\n                    <li>\u8bfa\u66fc\u5f81\u670d\u82f1\u683c\u5170\u540e\uff0c\u5a01\u5ec9\u4e00\u4e16\u7ee7\u7eed\u5de9\u56fa\u5bf9\u82f1\u683c\u5170\u7684\u7edf\u6cbb\u3002<span class=\"region-tag\">\u82f1\u683c\u5170</span></li>\n                </ul>\n            </div>\n\n            <!-- 997\u5e74 -->\n            <div class=\"year-section\">\n                <div class=\"year-title\">997\u5e74</div>\n                <ul class=\"event-list\">\n                    <li>\u5b8b\u771f\u5b97\u5728\u4f4d\u671f\u95f4\uff0c\u5b8b\u671d\u7ecf\u6d4e\u6587\u5316\u6301\u7eed\u53d1\u5c55\u3002<span class=\"region-tag\">\u4e2d\u56fd</span></li>\n                    <li>\u62dc\u5360\u5ead\u5e1d\u56fd\u7687\u5e1d\u5df4\u897f\u5c14\u4e8c\u4e16\u5f00\u59cb\u5bf9\u4fdd\u52a0\u5229\u4e9a\u7b2c\u4e00\u5e1d\u56fd\u53d1\u52a8\u957f\u671f\u6218\u4e89\uff08\"\u5df4\u5c14\u5e72\u6218\u5f79\"\uff09\u3002<span class=\"region-tag\">\u62dc\u5360\u5ead/\u4fdd\u52a0\u5229\u4e9a</span></li>\n                </ul>\n            </div>\n\n            <!-- 998\u5e74 -->\n            <div class=\"year-section\">\n                <div class=\"year-title\">998\u5e74</div>\n                <ul class=\"event-list\">\n                    <li>\u62dc\u5360\u5ead\u5e1d\u56fd\u4e0e\u4fdd\u52a0\u5229\u4e9a\u6218\u4e89\u6301\u7eed\uff0c\u5df4\u897f\u5c14\u4e8c\u4e16\u53d6\u5f97\u591a\u9879\u519b\u4e8b\u80dc\u5229\u3002<span class=\"region-tag\">\u5df4\u5c14\u5e72\u534a\u5c9b</span></li>\n                    <li>\u5b8b\u771f\u5b97\u65f6\u671f\uff0c\u5b8b\u671d\u4e0e\u8fbd\u56fd\u5173\u7cfb\u8d8b\u4e8e\u7a33\u5b9a\u3002<span class=\"region-tag\">\u4e2d\u56fd</span></li>\n                </ul>\n            </div>\n\n            <!-- 999\u5e74 -->\n            <div class=\"year-section\">\n                <div class=\"year-title\">999\u5e74</div>\n                <ul class=\"event-list\">\n                    <li>\u62dc\u5360\u5ead\u7687\u5e1d\u5df4\u897f\u5c14\u4e8c\u4e16\u7ee7\u7eed\u5bf9\u4fdd\u52a0\u5229\u4e9a\u7684\u5f81\u670d\u6218\u4e89\u3002<span class=\"region-tag\">\u5df4\u5c14\u5e72\u534a\u5c9b</span></li>\n                    <li>\u6b27\u6d32\u5404\u5730\u4fee\u9053\u9662\u6587\u5316\u7e41\u8363\uff0c\u5b66\u672f\u6d3b\u52a8\u6d3b\u8dc3\u3002<span class=\"region-tag\">\u6b27\u6d32</span></li>\n                </ul>\n            </div>\n\n            <!-- 1000\u5e74 -->\n            <div class=\"year-section\">\n                <div class=\"year-title\">1000\u5e74</div>\n                <ul class=\"event-list\">\n                    <li>\u516c\u51431000\u5e74\uff0c\u5343\u79a7\u5e74\u5230\u6765\uff0c\u6b27\u6d32\u5404\u5730\u4e3e\u884c\u76db\u5927\u5e86\u795d\u6d3b\u52a8\u3002<span class=\"region-tag\">\u6b27\u6d32</span></li>\n                    <li>\u5b8b\u671d\u7ee7\u7eed\u53d1\u5c55\u79d1\u4e3e\u5236\u5ea6\uff0c\u6587\u5316\u7e41\u8363\u3002<span class=\"region-tag\">\u4e2d\u56fd</span></li>\n                    <li>\u62dc\u5360\u5ead\u5e1d\u56fd\u4e0e\u4fdd\u52a0\u5229\u4e9a\u6218\u4e89\u63a5\u8fd1\u5c3e\u58f0\u3002<span class=\"region-tag\">\u5df4\u5c14\u5e72\u534a\u5c9b</span></li>\n                </ul>\n            </div>\n\n            <!-- 1001\u5e74 -->\n            <div class=\"year-section\">\n                <div class=\"year-title\">1001\u5e74</div>\n                <ul class=\"event-list\">\n                    <li>\u62dc\u5360\u5ead\u5e1d\u56fd\u57fa\u672c\u5b8c\u6210\u5bf9\u4fdd\u52a0\u5229\u4e9a\u7b2c\u4e00\u5e1d\u56fd\u7684\u5f81\u670d\uff0c\u5df4\u897f\u5c14\u4e8c\u4e16\u6210\u4e3a\u5df4\u5c14\u5e72\u5730\u533a\u7684\u9738\u4e3b\u3002<span class=\"region-tag\">\u62dc\u5360\u5ead</span></li>\n                    <li>\u5b8b\u671d\u4e0e\u8fbd\u56fd\u7ef4\u6301\u548c\u5e73\u72b6\u6001\uff0c\u8fb9\u5883\u8d38\u6613\u6d3b\u8dc3\u3002<span class=\"region-tag\">\u4e2d\u56fd</span></li>\n                </ul>\n            </div>\n\n            <!-- 1002\u5e74 -->\n            <div class=\"year-section\">\n                <div class=\"year-title\">1002\u5e74</div>\n                <ul class=\"event-list\">\n                    <li>\u62dc\u5360\u5ead\u5e1d\u56fd\u5de9\u56fa\u5bf9\u5df4\u5c14\u5e72\u5730\u533a\u7684\u63a7\u5236\uff0c\u6062\u590d\u5e1d\u56fd\u8363\u5149\u3002<span class=\"region-tag\">\u62dc\u5360\u5ead</span></li>\n                    <li>\u6b27\u6d32\u5404\u5730\u5c01\u5efa\u5236\u5ea6\u7ee7\u7eed\u53d1\u5c55\uff0c\u9a91\u58eb\u6587\u5316\u5174\u8d77\u3002<span class=\"region-tag\">\u6b27\u6d32</span></li>\n                </ul>\n            </div>\n\n            <!-- 1003\u5e74 -->\n            <div class=\"year-section\">\n                <div class=\"year-title\">1003\u5e74</div>\n                <ul class=\"event-list\">\n                    <li>\u5b8b\u771f\u5b97\u65f6\u671f\uff0c\u5b8b\u671d\u7ecf\u6d4e\u7e41\u8363\uff0c\u519c\u4e1a\u548c\u624b\u5de5\u4e1a\u53d1\u5c55\u8fc5\u901f\u3002<span class=\"region-tag\">\u4e2d\u56fd</span></li>\n                    <li>\u62dc\u5360\u5ead\u5e1d\u56fd\u5185\u90e8\u653f\u6cbb\u7a33\u5b9a\uff0c\u5df4\u897f\u5c14\u4e8c\u4e16\u7ee7\u7eed\u63a8\u884c\u6539\u9769\u3002<span class=\"region-tag\">\u62dc\u5360\u5ead</span></li>\n                </ul>\n            </div>\n\n            <!-- 1004\u5e74 -->\n            <div class=\"year-section\">\n                <div class=\"year-title\">1004\u5e74</div>\n                <ul class=\"event-list\">\n                    <li>\u5b8b\u671d\u4e0e\u8fbd\u56fd\u5728\u6fb6\u5dde\uff08\u4eca\u6cb3\u5357\u6fee\u9633\uff09\u53d1\u751f\u5927\u6218\uff0c\u5b8b\u519b\u53d6\u5f97\u5173\u952e\u80dc\u5229\u3002<span class=\"region-tag\">\u4e2d\u56fd</span></li>\n                    <li>\u6b64\u6218\u4e3a\u540e\u6765\u7684\"\u6fb6\u6e0a\u4e4b\u76df\"\u5960\u5b9a\u4e86\u57fa\u7840\u3002<span class=\"region-tag\">\u4e2d\u56fd</span></li>\n                </ul>\n            </div>\n\n            <!-- 1005\u5e74 -->\n            <div class=\"year-section\">\n                <div class=\"year-title\">1005\u5e74</div>\n                <ul class=\"event-list\">\n                    <li><strong>\u6fb6\u6e0a\u4e4b\u76df</strong>\uff1a\u5b8b\u671d\u4e0e\u8fbd\u56fd\u7b7e\u8ba2\u548c\u7ea6\uff0c\u53cc\u65b9\u7ef4\u6301\u548c\u5e73\u5173\u7cfb\u8fd1\u767e\u5e74\uff0c\u5b8b\u671d\u6bcf\u5e74\u5411\u8fbd\u56fd\u652f\u4ed8\u5c81\u5e01\u3002<span class=\"region-tag\">\u4e2d\u56fd</span></li>\n                    <li>\u8fd9\u4e00\u548c\u7ea6\u4fc3\u8fdb\u4e86\u5b8b\u8fbd\u4e4b\u95f4\u7684\u7ecf\u6d4e\u6587\u5316\u4ea4\u6d41\uff0c\u8fb9\u5883\u5730\u533a\u7e41\u8363\u53d1\u5c55\u3002<span class=\"region-tag\">\u4e2d\u56fd</span></li>\n                </ul>\n            </div>\n\n            <!-- 1006\u5e74 -->\n            <div class=\"year-section\">\n                <div class=\"year-title\">1006\u5e74</div>\n                <ul class=\"event-list\">\n                    <li>\u6fb6\u6e0a\u4e4b\u76df\u540e\uff0c\u5b8b\u8fbd\u8fb9\u5883\u8fdb\u5165\u548c\u5e73\u65f6\u671f\uff0c\u8d38\u6613\u5f80\u6765\u9891\u7e41\u3002<span class=\"region-tag\">\u4e2d\u56fd</span></li>\n                    <li>\u62dc\u5360\u5ead\u5e1d\u56fd\u7ee7\u7eed\u5de9\u56fa\u5176\u5728\u5df4\u5c14\u5e72\u548c\u5b89\u7eb3\u6258\u5229\u4e9a\u7684\u7edf\u6cbb\u3002<span class=\"region-tag\">\u62dc\u5360\u5ead</span></li>\n                </ul>\n            </div>\n\n            <!-- 1007\u5e74 -->\n            <div class=\"year-section\">\n                <div class=\"year-title\">1007\u5e74</div>\n                <ul class=\"event-list\">\n                    <li>\u5b8b\u671d\u5185\u90e8\u653f\u6cbb\u7a33\u5b9a\uff0c\u5b8b\u771f\u5b97\u7ee7\u7eed\u63a8\u884c\u6587\u6cbb\u653f\u7b56\u3002<span class=\"region-tag\">\u4e2d\u56fd</span></li>\n                    <li>\u6b27\u6d32\u5404\u5730\u5c01\u5efa\u9886\u4e3b\u4e4b\u95f4\u7684\u5c0f\u89c4\u6a21\u51b2\u7a81\u6301\u7eed\u3002<span class=\"region-tag\">\u6b27\u6d32</span></li>\n                </ul>\n            </div>\n\n            <!-- 1008\u5e74 -->\n            <div class=\"year-section\">\n                <div class=\"year-title\">1008\u5e74</div>\n                <ul class=\"event-list\">\n                    <li>\u62dc\u5360\u5ead\u5e1d\u56fd\u7687\u5e1d\u5df4\u897f\u5c14\u4e8c\u4e16\u7ee7\u7eed\u5de9\u56fa\u5e1d\u56fd\u7edf\u6cbb\u3002<span class=\"region-tag\">\u62dc\u5360\u5ead</span></li>\n                    <li>\u5b8b\u671d\u6587\u5316\u7ee7\u7eed\u7e41\u8363\uff0c\u7406\u5b66\u601d\u60f3\u5f00\u59cb\u840c\u82bd\u3002<span class=\"region-tag\">\u4e2d\u56fd</span></li>\n                </ul>\n            </div>\n\n            <!-- 1009\u5e74 -->\n            <div class=\"year-section\">\n                <div class=\"year-title\">1009\u5e74</div>\n                <ul class=\"event-list\">\n                    <li>\u62dc\u5360\u5ead\u5e1d\u56fd\u4e0e\u585e\u5c14\u67f1\u7a81\u53a5\u4eba\u5728\u5b89\u7eb3\u6258\u5229\u4e9a\u8fb9\u5883\u53d1\u751f\u51b2\u7a81\u3002<span class=\"region-tag\">\u5b89\u7eb3\u6258\u5229\u4e9a</span></li>\n                    <li>\u5b8b\u671d\u7ee7\u7eed\u7ef4\u6301\u4e0e\u8fbd\u56fd\u7684\u548c\u5e73\u5173\u7cfb\u3002<span class=\"region-tag\">\u4e2d\u56fd</span></li>\n                </ul>\n            </div>\n\n            <!-- 1010\u5e74 -->\n            <div class=\"year-section\">\n                <div class=\"year-title\">1010\u5e74</div>\n                <ul class=\"event-list\">\n                    <li>\u62dc\u5360\u5ead\u5e1d\u56fd\u9762\u4e34\u585e\u5c14\u67f1\u7a81\u53a5\u4eba\u7684\u65e5\u76ca\u589e\u957f\u7684\u538b\u529b\u3002<span class=\"region-tag\">\u5b89\u7eb3\u6258\u5229\u4e9a</span></li>\n                    <li>\u5b8b\u671d\u7ecf\u6d4e\u6587\u5316\u6301\u7eed\u53d1\u5c55\uff0c\u57ce\u5e02\u7e41\u8363\u3002<span class=\"region-tag\">\u4e2d\u56fd</span></li>\n                </ul>\n            </div>\n\n            <!-- 1011\u5e74 -->\n            <div class=\"year-section\">\n                <div class=\"year-title\">1011\u5e74</div>\n                <ul class=\"event-list\">\n                    <li>\u62dc\u5360\u5ead\u5e1d\u56fd\u4e0e\u585e\u5c14\u67f1\u7a81\u53a5\u4eba\u7684\u8fb9\u5883\u51b2\u7a81\u52a0\u5267\u3002<span class=\"region-tag\">\u5b89\u7eb3\u6258\u5229\u4e9a</span></li>\n                    <li>\u6b27\u6d32\u5404\u5730\u4fee\u9053\u9662\u7ee7\u7eed\u63a8\u52a8\u5b66\u672f\u548c\u6587\u5316\u53d1\u5c55\u3002<span class=\"region-tag\">\u6b27\u6d32</span></li>\n                </ul>\n            </div>\n\n            <!-- 1012\u5e74 -->\n            <div class=\"year-section\">\n                <div class=\"year-title\">1012\u5e74</div>\n                <ul class=\"event-list\">\n                    <li>\u62dc\u5360\u5ead\u5e1d\u56fd\u7687\u5e1d\u5df4\u897f\u5c14\u4e8c\u4e16\u53bb\u4e16\uff0c\u5176\u5f1f\u67e5\u58eb\u4e01\u5c3c\u4e8c\u4e16\u7ee7\u4f4d\u3002<span class=\"region-tag\">\u62dc\u5360\u5ead</span></li>\n                    <li>\u5b8b\u671d\u7ee7\u7eed\u7ef4\u6301\u5b8b\u8fbd\u548c\u5e73\u5c40\u9762\u3002<span class=\"region-tag\">\u4e2d\u56fd</span></li>\n                </ul>\n            </div>\n\n            <!-- 1013\u5e74 -->\n            <div class=\"year-section\">\n                <div class=\"year-title\">1013\u5e74</div>\n                <ul class=\"event-list\">\n                    <li>\u62dc\u5360\u5ead\u5e1d\u56fd\u65b0\u7687\u5e1d\u67e5\u58eb\u4e01\u5c3c\u4e8c\u4e16\u5373\u4f4d\uff0c\u9762\u4e34\u5185\u90e8\u548c\u5916\u90e8\u591a\u91cd\u6311\u6218\u3002<span class=\"region-tag\">\u62dc\u5360\u5ead</span></li>\n                    <li>\u585e\u5c14\u67f1\u7a81\u53a5\u4eba\u5728\u5b89\u7eb3\u6258\u5229\u4e9a\u7684\u5f71\u54cd\u529b\u7ee7\u7eed\u6269\u5927\u3002<span class=\"region-tag\">\u5b89\u7eb3\u6258\u5229\u4e9a</span></li>\n            